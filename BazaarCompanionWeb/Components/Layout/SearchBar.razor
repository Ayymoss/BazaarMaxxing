@using BazaarCompanionWeb.Dtos
@using BazaarCompanionWeb.Interfaces
@using BazaarCompanionWeb.Models.Pagination
@using BazaarCompanionWeb.Models.Pagination.MetaPaginations
@using BazaarCompanionWeb.Services
@using BazaarCompanionWeb.Utilities
@using Humanizer
@inject IResourceQueryHelper<ProductPagination, ProductDataInfo> ProductQuery
@inject NavigationManager NavigationManager

<div class="relative w-full group">
    <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5">
            <i class="ph ph-magnifying-glass text-sm text-slate-500 group-focus-within:text-[#e64653] transition-colors"></i>
        </div>
        <input @bind="_searchString" @oninput="OnSearchInput" @onfocus="OnFocus" @onblur="OnBlur"
               type="text"
               class="block h-8 w-full rounded border border-[#2a2f38] bg-[#101216] pl-8 pr-8 text-xs text-slate-200 placeholder:text-slate-500 focus:border-[#e64653]/60 focus:outline-none transition-colors"
               placeholder="Search symbol or sector…">

        <div class="absolute inset-y-0 right-0 flex items-center pr-2.5">
            @if (_isLoading)
            {
                <div class="h-3.5 w-3.5 animate-spin rounded-full border-2 border-[#e64653] border-t-transparent"></div>
            }
            else if (!string.IsNullOrEmpty(_searchString))
            {
                <button @onclick="ClearSearch" class="text-slate-500 hover:text-white transition-colors">
                    <i class="ph ph-x-circle"></i>
                </button>
            }
            else
            {
                <span class="hidden sm:block rounded border border-[#2a2f38] px-1.5 py-0.5 text-[10px] font-mono text-slate-600">/</span>
            }
        </div>
    </div>

    @if (_showResults && _results.Any())
    {
        <div class="absolute z-[100] mt-1.5 w-full overflow-hidden rounded-md border border-[#2a2f38] bg-[#1a1d23] shadow-2xl">
            <div class="max-h-[480px] overflow-y-auto no-scrollbar">
                <div class="border-b border-[#2a2f38] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-widest text-slate-500">
                    Search Results (@_results.Count)
                </div>
                @foreach (var product in _results)
                {
                    <div @onmousedown="() => NavigateToProduct(product.ItemId)"
                         class="group flex cursor-pointer items-center justify-between border-b border-[#23272f] p-2.5 transition-colors last:border-0 hover:bg-[#e64653]/[0.08]">
                        <div class="flex items-center gap-2.5">
                            <MinecraftHead SkinUrl="@product.SkinUrl" Tier="@product.ItemTier" Size="28" Class="rounded-[3px]" />
                            <div class="flex flex-col">
                                <span class="text-xs font-medium text-slate-200 group-hover:text-white transition-colors">@product.ItemFriendlyName</span>
                                <span class="text-[10px] text-slate-500">@product.ItemTier.Humanize()</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2.5 font-mono">
                            <div class="flex flex-col items-end">
                                <span class="text-[8px] uppercase leading-none text-slate-500">Bid</span>
                                <span class="text-xs font-medium text-[#16c784]">@product.BidUnitPrice.ToString("N0")</span>
                            </div>
                            <div class="h-5 w-px bg-[#2a2f38]"></div>
                            <div class="flex flex-col items-end">
                                <span class="text-[8px] uppercase leading-none text-slate-500">Ask</span>
                                <span class="text-xs font-medium text-[#f6465d]">@product.AskUnitPrice.ToString("N0")</span>
                            </div>
                            <div class="h-5 w-px bg-[#2a2f38]"></div>
                            <div class="flex flex-col items-end">
                                <span class="text-[8px] uppercase leading-none text-slate-500">Rating</span>
                                <span class="text-xs font-semibold" style="color: @product.OrderMetaFlipOpportunityScore.RatingColor()">@product.OrderMetaFlipOpportunityScore.ToString("N1")</span>
                            </div>
                        </div>
                    </div>
                }
                <button @onmousedown="SeeAllResults" class="w-full bg-[#101216] py-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400 transition-colors hover:bg-white/5 hover:text-white">
                    See All Results
                </button>
            </div>
        </div>
    }
    else if (_showResults && !string.IsNullOrWhiteSpace(_searchString) && !_isLoading)
    {
        <div class="absolute z-[100] mt-1.5 w-full overflow-hidden rounded-md border border-[#2a2f38] bg-[#1a1d23] p-8 text-center shadow-2xl">
            <i class="ph ph-magnifying-glass mb-2 text-3xl text-slate-700"></i>
            <p class="text-sm text-slate-400">No products found for "@_searchString"</p>
        </div>
    }
</div>
