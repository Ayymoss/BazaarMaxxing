@using BazaarCompanionWeb.Services
@rendermode InteractiveServer
@inject ComparisonStateService ComparisonState
@inject AboutModalService AboutModalService
@implements IDisposable

<div class="flex h-12 w-full items-center px-3.5">
    <!-- Brand mark -->
    <a href="/" class="flex items-center">
        <span class="flex h-[26px] w-[26px] items-center justify-center rounded-[3px] bg-[#e64653] text-[13px] font-bold tracking-tighter text-white">B</span>
        <span class="ml-2.5 text-sm font-semibold tracking-tight text-slate-100">Bazaar<span class="text-[#e64653]"> Maxxing</span></span>
    </a>

    <!-- Primary nav (tab style) -->
    <nav class="ml-5 hidden items-center md:flex">
        <NavLink href="/" Match="NavLinkMatch.All" class="navtab">Markets</NavLink>
        <NavLink href="/analytics" class="navtab">Analytics</NavLink>
    </nav>

    <!-- Right: search + actions -->
    <div class="ml-auto flex items-center gap-1.5">
        <div class="hidden lg:block w-[280px]">
            <SearchBar />
        </div>
        <a href="/compare" class="group relative flex h-8 w-8 items-center justify-center rounded text-slate-400 hover:bg-white/5 hover:text-white transition-colors">
            <i class="ph ph-git-diff text-lg"></i>
            @if (ComparisonState.Count > 0)
            {
                <span class="absolute -top-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-[#e64653] text-[10px] font-bold text-white">
                    @ComparisonState.Count
                </span>
            }
        </a>
        <a href="https://github.com/Ayymoss" target="_blank" class="flex h-8 w-8 items-center justify-center rounded text-slate-400 hover:bg-white/5 hover:text-white transition-colors">
            <i class="ph ph-github-logo text-lg"></i>
        </a>
        <button @onclick="AboutModalService.Show" class="flex h-8 w-8 items-center justify-center rounded text-slate-400 hover:bg-white/5 hover:text-white transition-colors">
            <i class="ph ph-info text-lg"></i>
        </button>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        ComparisonState.OnChange += OnComparisonChanged;
    }

    private void OnComparisonChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ComparisonState.OnChange -= OnComparisonChanged;
    }
}
