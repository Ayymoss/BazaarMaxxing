@using BazaarCompanionWeb.Services
@using BazaarCompanionWeb.Utilities
@rendermode InteractiveServer
@inject AboutModalService AboutModalService
@implements IDisposable

<Modal Show="@AboutModalService.IsVisible" ShowChanged="OnShowChanged">
    <div class="max-w-lg mx-auto">
        <!-- Header -->
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center h-14 w-14 rounded-md border border-[#e64653]/30 bg-[#e64653]/10 text-[#e64653] mb-3">
                <i class="ph-fill ph-trend-up text-2xl"></i>
            </div>
            <h2 class="text-xl font-semibold text-white mb-1">Bazaar Maxxing</h2>
            <p class="font-mono text-xs text-slate-500">Version @HelperMethods.GetVersion()</p>
        </div>

        <!-- Description -->
        <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23] p-4 mb-4">
            <h3 class="text-[11px] font-semibold uppercase tracking-wider text-[#e64653] mb-2">About This Project</h3>
            <p class="text-sm leading-relaxed text-slate-300">
                Bazaar Maxxing is a market analytics tool for Hypixel Skyblock's Bazaar.
                Track real-time prices, analyze market trends with OHLC charts, compare products side-by-side,
                and discover profitable trading opportunities. Built for traders who want to maximize their profits
                with data-driven insights.
            </p>
        </div>

        <!-- Credits -->
        <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23] p-4 mb-4">
            <h3 class="text-[11px] font-semibold uppercase tracking-wider text-[#e64653] mb-3">Credits</h3>
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-md border border-[#2a2f38] bg-[#e64653]/15 text-[#e64653]">
                    <i class="ph ph-user text-lg"></i>
                </div>
                <div>
                    <p class="font-medium text-slate-200">Ayymoss</p>
                    <p class="text-sm text-slate-500">Developer</p>
                </div>
            </div>
        </div>

        <!-- Links -->
        <div class="flex flex-col gap-2.5">
            <a href="https://github.com/Ayymoss" target="_blank"
               class="flex items-center gap-3 rounded-md border border-[#2a2f38] bg-[#101216] p-3 text-slate-300 transition-colors hover:bg-white/5 hover:text-white">
                <i class="ph ph-github-logo text-xl"></i>
                <span class="font-medium">GitHub</span>
                <i class="ph ph-arrow-square-out ml-auto text-sm text-slate-500"></i>
            </a>
            <div class="flex items-center gap-3 rounded-md border border-[#2a2f38] bg-[#101216] p-3 text-slate-300">
                <i class="ph ph-discord-logo text-xl"></i>
                <span class="font-medium">Discord: ayymoss</span>
            </div>
        </div>

        <!-- Footer -->
        <div class="mt-6 pt-4 border-t border-[#2a2f38] text-center">
            <p class="text-xs text-slate-500">
                Made with <i class="ph-fill ph-heart text-[#e64653]"></i> for the Hypixel Skyblock community
            </p>
        </div>
    </div>
</Modal>

@code {
    protected override void OnInitialized()
    {
        AboutModalService.OnChange += OnServiceChange;
    }

    private void OnServiceChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnShowChanged(bool value)
    {
        if (!value)
        {
            AboutModalService.Hide();
        }
    }

    public void Dispose()
    {
        AboutModalService.OnChange -= OnServiceChange;
    }
}
