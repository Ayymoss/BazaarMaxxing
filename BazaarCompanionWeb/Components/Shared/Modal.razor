@if (Show)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black/70 transition-opacity animate-in fade-in duration-200"
             @onclick="HandleBackdropClick"></div>

        <!-- Modal Panel -->
        <div class="relative z-50 flex w-full max-w-5xl flex-col overflow-hidden rounded-md border border-[#2a2f38] bg-[#1a1d23] shadow-2xl animate-in fade-in zoom-in-95 slide-in-from-bottom-2 duration-300 max-h-[85vh]"
             @onclick:stopPropagation="true">

            @if (ShowClose)
            {
                <button @onclick="Close"
                        class="absolute right-3 top-3 z-10 flex h-7 w-7 items-center justify-center rounded text-slate-400 ring-1 ring-inset ring-[#2a2f38] bg-[#101216] transition-all hover:bg-white/5 hover:text-white focus:outline-none focus:ring-2 focus:ring-[#e64653]">
                    <i class="ph ph-x text-sm"></i>
                    <span class="sr-only">Close</span>
                </button>
            }

            <div class="flex-1 overflow-y-auto overflow-x-hidden p-4 sm:p-6 modal-body scrollbar-thin scrollbar-track-transparent scrollbar-thumb-slate-700">
                @ChildContent
            </div>
        </div>
    </div>
}
