@page "/compare"
@using BazaarCompanionWeb.Dtos
@using BazaarCompanionWeb.Entities
@using BazaarCompanionWeb.Components.Pages.Components
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Compare Products | Bazaar Maxxing</PageTitle>

<div class="flex flex-col gap-3 w-full max-w-[1920px] mx-auto">
    <PageHeader BackHref="/" Title="Compare Products" Icon="ph-git-diff">
        <Status>
            <span class="font-mono text-[11px] text-slate-500">Overlay normalized price movements</span>
        </Status>
        <Actions>
            @if (_productKeys.Count > 0)
            {
                <button @onclick="ClearAll"
                        class="flex items-center gap-2 rounded border border-[#2a2f38] bg-[#101216] px-3 py-1.5 text-xs font-medium text-slate-400 transition-colors hover:bg-[#e64653]/10 hover:text-[#f25c68]">
                    <i class="ph ph-trash"></i> Clear All
                </button>
            }
        </Actions>
    </PageHeader>

    <!-- Product Selection Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @foreach (var productKey in _productKeys)
        {
            var product = _productData.GetValueOrDefault(productKey);
            <div
                class="group relative rounded-md border border-[#2a2f38] bg-[#1a1d23] p-4 transition-all hover:border-slate-600">
                <button @onclick="@(() => RemoveProduct(productKey))"
                        aria-label="Remove from comparison"
                        title="Remove from comparison"
                        class="absolute top-2 right-2 p-1 rounded-md text-slate-600 hover:text-[#f25c68] hover:bg-[#e64653]/10 opacity-0 group-hover:opacity-100 transition-all">
                    <i class="ph ph-x text-sm" aria-hidden="true"></i>
                </button>

                @if (product is not null)
                {
                    <a href="/product/@productKey" class="block">
                        <h3 class="font-medium text-slate-200 truncate hover:text-[#f25c68] transition-colors">
                            @product.ItemFriendlyName
                        </h3>
                        <div class="flex items-center justify-between mt-3 text-xs">
                            <span class="text-slate-500">Ask</span>
                            <span class="font-mono text-[#f6465d]">@product.AskUnitPrice.ToString("N1")</span>
                        </div>
                        <div class="flex items-center justify-between mt-1 text-xs">
                            <span class="text-slate-500">Bid</span>
                            <span class="font-mono text-[#16c784]">@product.BidUnitPrice.ToString("N1")</span>
                        </div>
                    </a>
                }
                else
                {
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-sm text-slate-500 truncate">@productKey</span>
                        <div class="h-3 w-3 animate-spin rounded-full border-2 border-slate-600 border-t-[#e64653]"></div>
                    </div>
                }
            </div>
        }

        @if (_productKeys.Count < 4)
        {
            <div
                class="flex flex-col items-center justify-center rounded-md border border-dashed border-[#2a2f38] bg-[#1a1d23] p-6 min-h-[120px]">
                <div class="relative w-full max-w-[200px]">
                    <input type="text"
                           @oninput="OnSearchInput"
                           value="@_searchQuery"
                           placeholder="Search products..."
                           class="w-full px-3 py-2 rounded border border-[#2a2f38] bg-[#101216] text-sm text-slate-200 placeholder-slate-600 focus:border-[#e64653]/60 focus:outline-none transition-all"/>
                </div>

                @if (_searchResults.Any())
                {
                    <div
                        class="mt-2 w-full max-w-[200px] max-h-[150px] overflow-auto rounded-md border border-[#2a2f38] bg-[#1a1d23]">
                        @foreach (var result in _searchResults.Take(5))
                        {
                            <button @onclick="@(() => AddProduct(result.ItemId))"
                                    class="w-full text-left px-3 py-2 text-xs text-slate-200 hover:bg-[#101216] hover:text-white transition-colors truncate">
                                @result.ItemFriendlyName
                            </button>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <p class="mt-2 text-xs text-slate-600">No products found</p>
                }
                else
                {
                    <p class="mt-2 text-xs text-slate-500">Add products from their detail pages</p>
                }
            </div>
        }
    </div>

    <!-- Comparison Chart -->
    @if (_productKeys.Count > 0)
    {
        <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23] overflow-hidden">
            <div class="flex items-center justify-between p-4 border-b border-[#2a2f38]">
                <h2 class="text-sm font-semibold text-slate-200 flex items-center gap-2">
                    <i class="ph ph-chart-line-up text-[#e64653]"></i>
                    Normalized Price Comparison
                </h2>
                <div class="flex items-center gap-2">
                    @foreach (var interval in _intervals)
                    {
                        <button @onclick="@(() => SetInterval(interval.Value))"
                                class="@GetIntervalButtonClasses(interval.Value)">
                            @interval.Label
                        </button>
                    }
                </div>
            </div>
            <div class="relative w-full h-[400px] p-4">
                @if (_loading)
                {
                    <div class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-[#1a1d23]/80">
                        <div class="h-1 w-32 overflow-hidden rounded-full bg-[#101216]">
                            <div class="h-full w-full origin-left animate-[indeterminate_1s_infinite_linear] bg-[#e64653]"></div>
                        </div>
                        <p class="mt-3 text-xs text-slate-500 animate-pulse">Loading chart data...</p>
                    </div>
                }
                <div id="comparison-chart-@_chartId" class="absolute inset-4"></div>
            </div>
            <div class="px-4 pb-4">
                <p class="text-[10px] text-slate-600 text-center">
                    <i class="ph ph-info mr-1"></i>
                    Values normalized to % change from first data point for each product
                </p>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center py-20 rounded-md border border-dashed border-[#2a2f38] bg-[#1a1d23]">
            <i class="ph ph-git-diff text-5xl text-slate-700 mb-4"></i>
            <h2 class="text-lg font-medium text-slate-200 mb-2">No products to compare</h2>
            <p class="text-sm text-slate-500 text-center max-w-md mb-6">
                Add products from their detail pages using the "Compare" button, or search for products above.
            </p>
            <a href="/" class="px-4 py-2 rounded-md bg-[#e64653] hover:bg-[#f25c68] text-white text-sm font-medium transition-colors">
                Browse Products
            </a>
        </div>
    }

    <!-- Legend -->
    @if (_productKeys.Count > 0)
    {
        <div class="flex flex-wrap items-center justify-center gap-4 p-4 rounded-md border border-[#2a2f38] bg-[#1a1d23]">
            @for (var i = 0; i < _productKeys.Count; i++)
            {
                var productKey = _productKeys[i];
                var product = _productData.GetValueOrDefault(productKey);
                var color = _colors[i % _colors.Length];
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full" style="background-color: @color"></div>
                    <span class="text-xs text-slate-200">@(product?.ItemFriendlyName ?? productKey)</span>
                </div>
            }
        </div>
    }
</div>
