@page "/product/{ProductKey}"
@using BazaarCompanionWeb.Components.Pages.Components
@using BazaarCompanionWeb.Components.Pages.Dialogs.Components
@using BazaarCompanionWeb.Utilities
@rendermode InteractiveServer

<PageTitle>@(ProductData?.ItemFriendlyName ?? "Loading...") | Bazaar Maxxing</PageTitle>

<div class="-mx-4 -my-6 flex h-[calc(100vh-49px)] sm:-mx-6 lg:-mx-8">
    @if (_loading)
    {
        <div class="flex flex-1 flex-col items-center justify-center">
            <div class="h-1 w-32 overflow-hidden rounded-full bg-[#2a2f38]">
                <div class="h-full w-full origin-left animate-[indeterminate_1s_infinite_linear] bg-[#e64653]"></div>
            </div>
            <p class="mt-3 font-mono text-xs text-slate-500">Fetching market data…</p>
        </div>
    }
    else if (ProductData is null)
    {
        <div class="flex flex-1 flex-col items-center justify-center gap-3">
            <i class="ph ph-warning-circle text-4xl text-[#d99a00]"></i>
            <p class="text-sm font-medium text-slate-300">Product not found</p>
            <p class="text-xs text-slate-500">"@ProductKey" could not be found.</p>
            <a href="/" class="mt-2 rounded bg-[#e64653] px-4 py-2 text-xs font-medium text-white hover:bg-[#f25c68]">Return to Markets</a>
        </div>
    }
    else
    {
        var history = GetLastPriceHistoryAverage();
        var hasLtp = ProductData.EstimatedLastTradedPrice.HasValue;
        var currentMid = ProductData.EstimatedLastTradedPrice ?? (ProductData.BidUnitPrice + ProductData.AskUnitPrice) / 2;
        var refMid = (history.Bid + history.Ask) / 2;
        var change = currentMid - refMid;
        var pct = refMid > 0 ? change / refMid : 0;
        var up = change >= 0;
        var col = up ? "#16c784" : "#f6465d";
        var spreadPct = ProductData.BidUnitPrice > 0 ? ProductData.OrderMetaSpread / ProductData.BidUnitPrice : 0;

        <!-- LEFT: watchlist rail -->
        <aside class="hidden w-[232px] flex-none flex-col border-r border-[#2a2f38] bg-[#15171c] md:flex">
            <WatchlistRail CurrentKey="@ProductKey" />
        </aside>

        <!-- CENTER: chart workspace -->
        <main class="flex min-w-0 flex-1 flex-col bg-[#15171c]">
            <div class="flex items-center gap-0.5 overflow-x-auto border-b border-[#2a2f38] px-2 no-scrollbar">
                @foreach (var (key, label) in new[] { ("chart", "Chart"), ("book", "Order Book"), ("analysis", "Depth Analysis"), ("related", "Related") })
                {
                    <button class="wtab @(_activeTab == key ? "active" : "")" @onclick="() => SetTab(key)">@label</button>
                }
            </div>

            <div class="relative min-h-0 flex-1">
                <!-- Chart (kept mounted to avoid re-init) -->
                <div class="absolute inset-0 @(_activeTab == "chart" ? "" : "hidden")">
                    <PriceGraph @ref="_priceGraph" Product="ProductData" Interval="@_selectedInterval" IntervalChanged="@OnIntervalChangedAsync"/>
                </div>

                @if (_activeTab == "book")
                {
                    var asks = ProductData.AskBook ?? [];
                    var bids = ProductData.BidBook ?? [];
                    var maxAmt = Math.Max(asks.Count > 0 ? asks.Max(o => o.Amount) : 0, bids.Count > 0 ? bids.Max(o => o.Amount) : 0);
                    if (maxAmt <= 0) maxAmt = 1;
                    <div class="absolute inset-0 flex flex-col overflow-auto">
                        <div class="phdr"><span>Order Book</span><span class="font-mono text-[11px] normal-case text-slate-500">Price · Size · Orders</span></div>
                        @foreach (var o in asks.AsEnumerable().Reverse())
                        {
                            <div class="ob"><span class="bar" style="background:#f6465d; width:@((o.Amount / (double)maxAmt * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                <span class="px" style="color:#f6465d">@o.UnitPrice.ToString("N1")</span>
                                <span class="qty">@o.Amount.ToString("N0") · @o.Orders</span></div>
                        }
                        <div class="flex items-center justify-between border-y border-[#2a2f38] bg-[#1a1d23] px-3 py-1.5 font-mono text-[11px]">
                            <span class="text-slate-500">SPREAD</span>
                            <span class="text-slate-300">@ProductData.OrderMetaSpread.ToString("N1") · @spreadPct.ToString("P1")</span>
                        </div>
                        @foreach (var o in bids)
                        {
                            <div class="ob"><span class="bar" style="background:#16c784; width:@((o.Amount / (double)maxAmt * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                <span class="px" style="color:#16c784">@o.UnitPrice.ToString("N1")</span>
                                <span class="qty">@o.Amount.ToString("N0") · @o.Orders</span></div>
                        }
                    </div>
                }
                else if (_activeTab == "analysis")
                {
                    <div class="absolute inset-0 overflow-auto p-3">
                        @if (_orderBookAnalysis is not null)
                        {
                            <div class="flex flex-col gap-3">
                                <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
                                    <ImbalanceGauge Imbalance="@_orderBookAnalysis.Imbalance"/>
                                    <WhaleOrders Orders="@_orderBookAnalysis.WhaleOrders"/>
                                </div>
                                <OrderBookDepth DepthMetrics="@_orderBookAnalysis.DepthMetrics" DepthChart="@_orderBookAnalysis.DepthChart"/>
                                <OrderBookSupportResistance SupportLevels="@_orderBookAnalysis.SupportLevels" ResistanceLevels="@_orderBookAnalysis.ResistanceLevels"/>
                            </div>
                        }
                        else
                        {
                            <div class="flex h-full items-center justify-center text-xs text-slate-500">No order-book analysis available.</div>
                        }
                    </div>
                }
                else if (_activeTab == "related")
                {
                    <div class="absolute inset-0 overflow-auto p-3">
                        @if (_relatedProductsFailed)
                        {
                            <ErrorCallout Message="Couldn't load related products" Detail="Check service health if this persists." OnRetry="@(() => LoadRelatedProductsAsync())"/>
                        }
                        else if (_relatedProducts.Any())
                        {
                            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
                                @foreach (var related in _relatedProducts)
                                {
                                    var cc = related.CorrelationType switch { "Strong" => "#16c784", "Moderate" => "#d99a00", _ => "#9aa0aa" };
                                    <a href="/product/@related.ProductKey" class="group rounded-md border border-[#2a2f38] bg-[#1a1d23] p-3 hover:bg-white/5">
                                        <p class="mb-1.5 truncate text-xs font-medium text-slate-200 group-hover:text-white">@related.ProductName</p>
                                        <div class="flex items-center justify-between font-mono text-[10px]">
                                            <span class="text-slate-500">@related.CorrelationType</span>
                                            <span style="color:@cc">@related.Correlation.ToString("P1")</span>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="flex h-full flex-col items-center justify-center gap-1 text-xs text-slate-500">
                                <span>No correlated products yet.</span>
                                <span class="text-[10px] text-slate-600">Correlations are built from candle history and refresh periodically.</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="flex items-center justify-between border-t border-[#2a2f38] px-3 py-1.5 font-mono text-[11px] text-slate-500">
                <span>Market depth shows active orders · % change vs 12h reference</span>
                <span class="flex items-center gap-1.5" title="@LiveDotTitle()"><span class="h-1.5 w-1.5 rounded-full @LiveDotClass()"></span>@(_lastServerRefresh?.Humanize() ?? "…")</span>
            </div>
        </main>

        <!-- RIGHT: quote panel -->
        <aside class="flex w-[336px] flex-none flex-col overflow-auto border-l border-[#2a2f38] bg-[#1a1d23]">
            <div class="px-3.5 pt-3">
                <div class="flex items-center gap-2">
                    <MinecraftHead SkinUrl="@ProductData.SkinUrl" Tier="@ProductData.ItemTier" Size="24" Class="rounded-[3px]" />
                    <span class="truncate text-sm font-semibold text-white">@ProductData.ItemFriendlyName</span>
                    <span class="rounded-sm border px-1.5 py-px text-[10px] font-medium" style="color:@ProductData.ItemTier.ProductTierColor(); border-color:@(ProductData.ItemTier.ProductTierColor())55">@ProductData.ItemTier.Humanize()</span>
                </div>
                <div class="mt-2 flex items-end gap-2">
                    <span class="font-mono text-[30px] font-semibold leading-none text-white">@currentMid.ToString("N1")</span>
                    <span class="mb-0.5 font-mono text-xs @(hasLtp ? "text-cyan-500" : "text-slate-500")" title="@(hasLtp ? "Estimated last traded price" : "Bid/ask midpoint")">@(hasLtp ? "eLTP" : "MID")</span>
                </div>
                <div class="mt-1 font-mono text-sm" style="color:@col">@(up ? "+" : "")@change.ToString("N1") &nbsp; @(up ? "+" : "")@pct.ToString("P2") @(up ? "▲" : "▼")</div>

                <div class="mt-2 grid grid-cols-2 gap-2 text-[12px]">
                    <div class="rounded border border-[#2a2f38] bg-[#101216] px-2.5 py-1.5">
                        <div class="text-[10px] uppercase text-slate-500">Ask × Vol</div>
                        <div class="font-mono" style="color:#f6465d">@ProductData.AskUnitPrice.ToString("N1") <span class="text-slate-500">× @ProductData.AskCurrentVolume.ToString("N0")</span></div>
                    </div>
                    <div class="rounded border border-[#2a2f38] bg-[#101216] px-2.5 py-1.5">
                        <div class="text-[10px] uppercase text-slate-500">Bid × Vol</div>
                        <div class="font-mono" style="color:#16c784">@ProductData.BidUnitPrice.ToString("N1") <span class="text-slate-500">× @ProductData.BidCurrentVolume.ToString("N0")</span></div>
                    </div>
                </div>

                <button @onclick="ToggleCompare"
                        class="mt-2.5 flex h-9 w-full items-center justify-center gap-2 rounded text-xs font-medium transition-colors @(_isInComparison ? "border border-[#2a2f38] bg-[#101216] text-emerald-400" : "bg-[#e64653] text-white hover:bg-[#f25c68]")">
                    @if (_isInComparison)
                    {
                        <i class="ph ph-check-circle"></i><span>In Compare</span>
                    }
                    else
                    {
                        <i class="ph ph-git-diff"></i><span>Add to Compare</span>
                    }
                </button>
            </div>

            <!-- trade recommendation (special callout) -->
            @if (ProductData.SuggestedBidVolume is > 0)
            {
                var conf = ProductData.RecommendationConfidence ?? 0;
                var confCol = conf >= 0.5 ? "#16c784" : conf >= 0.25 ? "#d99a00" : "#f6465d";
                <div class="m-3 overflow-hidden rounded-md border border-[#d99a00]/30 bg-[#d99a00]/[0.05] shadow-[inset_2px_0_0_0_#d99a00]">
                    <div class="flex items-center justify-between border-b border-[#d99a00]/20 px-3 py-1.5">
                        <span class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#e0a516]"><i class="ph-fill ph-lightning"></i> Trade Recommendation</span>
                        <span class="font-mono text-[11px]" style="color:@confCol">@((conf * 100).ToString("F0"))% conf</span>
                    </div>
                    <div class="grid grid-cols-2">
                        <div class="border-b border-r border-[#2a2f38]/70 px-3 py-2"><div class="text-[10px] uppercase tracking-wide text-slate-500">Bid Qty</div><div class="font-mono text-sm text-slate-200">@ProductData.SuggestedBidVolume?.ToString("N0")</div></div>
                        <div class="border-b border-[#2a2f38]/70 px-3 py-2"><div class="text-[10px] uppercase tracking-wide text-slate-500">Bid Price</div><div class="font-mono text-sm" style="color:#16c784" title="@ProductData.SuggestedBidPrice?.ToString("N2")">@(ProductData.SuggestedBidPrice?.ToCompactString() ?? "-")</div></div>
                        <div class="border-r border-[#2a2f38]/70 px-3 py-2"><div class="text-[10px] uppercase tracking-wide text-slate-500">Ask Price</div><div class="font-mono text-sm" style="color:#f6465d" title="@ProductData.SuggestedAskPrice?.ToString("N2")">@(ProductData.SuggestedAskPrice?.ToCompactString() ?? "-")</div></div>
                        <div class="px-3 py-2"><div class="text-[10px] uppercase tracking-wide text-slate-500">Est. Profit</div><div class="font-mono text-sm" style="color:#d99a00" title="@ProductData.EstimatedTotalProfit?.ToString("N2")">@(ProductData.EstimatedTotalProfit?.ToCompactString() ?? "-")</div></div>
                    </div>
                    <div class="flex items-center justify-between border-t border-[#d99a00]/15 px-3 py-1.5 text-[11px]">
                        <span class="text-slate-500">Per unit</span><span class="font-mono" style="color:#d99a00">@ProductData.EstimatedProfitPerUnit?.ToString("N1")</span>
                    </div>
                    <div class="flex items-center justify-between border-t border-[#d99a00]/10 px-3 py-1.5 text-[11px]">
                        <span class="text-slate-500">Est. fill (round-trip)</span><span class="font-mono text-slate-300">~@ProductData.EstimatedFillTimeHours?.ToString("N1")h</span>
                    </div>
                </div>
            }

            <!-- price trend -->
            @{
                var spark = Sparkline(300, 56);
                var sparkPeriod = _sparkCandles.Count >= 2 ? "72H" : ((_product?.PriceHistory?.Count ?? 0) >= 2 ? "64D" : "");
            }
            <div class="mt-1 border-t border-[#2a2f38]">
                <div class="phdr"><span>Price Trend</span><span class="font-mono text-[11px] normal-case text-slate-500">@sparkPeriod</span></div>
                <div class="px-3.5 py-2">
                    @if (!string.IsNullOrEmpty(spark.Points))
                    {
                        <svg width="100%" height="56" viewBox="0 0 300 56" preserveAspectRatio="none">
                            <polyline points="@spark.Points" fill="none" stroke="@(spark.Up ? "#16c784" : "#f6465d")" stroke-width="1.5" />
                        </svg>
                    }
                    else
                    {
                        <div class="flex h-[56px] items-center justify-center font-mono text-[10px] text-slate-600">No price data yet</div>
                    }
                </div>
            </div>

            <!-- top of book -->
            @{
                var mAsks = (ProductData.AskBook ?? []).Take(5).Reverse().ToList();
                var mBids = (ProductData.BidBook ?? []).Take(5).ToList();
                var mMax = Math.Max(mAsks.Count > 0 ? mAsks.Max(o => o.Amount) : 0, mBids.Count > 0 ? mBids.Max(o => o.Amount) : 0);
                if (mMax <= 0) mMax = 1;
            }
            <div class="mt-3 border-t border-[#2a2f38]">
                <div class="phdr"><span>Order Book</span><button class="font-mono text-[11px] normal-case text-[#60a5fa]" @onclick='() => SetTab("book")'>Expand</button></div>
                @if (mAsks.Count == 0 && mBids.Count == 0)
                {
                    <div class="px-3 py-3 text-center text-xs text-slate-500">No active orders</div>
                }
                else
                {
                    @foreach (var o in mAsks)
                    {
                        <div class="ob"><span class="bar" style="background:#f6465d; width:@((o.Amount / (double)mMax * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                            <span class="px" style="color:#f6465d">@o.UnitPrice.ToString("N1")</span><span class="qty text-slate-500">@o.Amount.ToString("N0")</span></div>
                    }
                    <div class="flex items-center justify-between border-y border-[#2a2f38] px-3 py-1 font-mono text-[11px]"><span class="text-slate-500">SPREAD</span><span class="text-slate-300">@ProductData.OrderMetaSpread.ToString("N1")</span></div>
                    @foreach (var o in mBids)
                    {
                        <div class="ob"><span class="bar" style="background:#16c784; width:@((o.Amount / (double)mMax * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                            <span class="px" style="color:#16c784">@o.UnitPrice.ToString("N1")</span><span class="qty text-slate-500">@o.Amount.ToString("N0")</span></div>
                    }
                }
            </div>

            <!-- key stats -->
            <div class="mt-1 border-t border-[#2a2f38]">
                <div class="phdr"><span>Key Statistics</span></div>
                <div class="stat"><span class="k">Spread</span><span class="v text-slate-300">@ProductData.OrderMetaSpread.ToString("N1") · @spreadPct.ToString("P1")</span></div>
                <div class="stat"><span class="k">Profit Multiplier</span><span class="v" style="color:@ProductData.OrderMetaPotentialProfitMultiplier.MultiplierColor()">@ProductData.OrderMetaPotentialProfitMultiplier.ToString("N2")×</span></div>
                <div class="stat"><span class="k">Flip Rating</span><span class="v" style="color:@ProductData.OrderMetaFlipOpportunityScore.RatingColor()">@ProductData.OrderMetaFlipOpportunityScore.ToString("N1")</span></div>
                <div class="stat"><span class="k">7d Volume</span><span class="v text-slate-300">@ProductData.OrderMetaTotalWeekVolume.ToString("N0")</span></div>
                <div class="stat"><span class="k">7d Bid / Ask Vol</span><span class="v text-slate-300">@ProductData.BidWeekVolume.ToString("N0") / @ProductData.AskWeekVolume.ToString("N0")</span></div>
                @if (ProductData.EstimatedProfitPerUnit is > 0)
                {
                    <div class="stat"><span class="k">Est. Profit / unit</span><span class="v" style="color:#d99a00">+@ProductData.EstimatedProfitPerUnit?.ToString("N1")</span></div>
                }
                <div class="stat"><span class="k">Manipulation</span><span class="v" style="color:@(ProductData.IsManipulated ? "#f6465d" : "#16c784")">@(ProductData.IsManipulated ? $"Flagged ({ProductData.PriceDeviationPercent:F1}%)" : "Clean")</span></div>
            </div>
        </aside>
    }
</div>
