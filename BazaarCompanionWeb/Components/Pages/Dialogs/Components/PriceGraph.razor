@rendermode InteractiveServer

<div class="flex h-full min-h-0 flex-col bg-[#15171c]">
    <!-- Chart toolbar: interval (time) + indicators -->
    <div class="flex flex-wrap items-center gap-2 border-b border-[#2a2f38] bg-[#1a1d23] px-2.5 py-1.5">
        <ChartIntervalSelector SelectedInterval="Interval" OnIntervalChanged="OnIntervalChangedAsync" />
        <div class="h-4 w-px bg-[#2a2f38]"></div>
        <i class="ph ph-chart-line-up text-sm text-slate-500"></i>
        <div class="flex flex-wrap items-center gap-1">
            @foreach (var def in Defs)
            {
                <button type="button" class="indchip @(_enabled[def.Key] ? "on" : "")"
                        @onclick="@(() => ToggleIndicatorAsync(def.Key, !_enabled[def.Key]))">
                    @def.Label
                </button>
            }
        </div>
    </div>

    <div class="relative min-h-[360px] w-full flex-1 overflow-hidden">
        <div id="@ContainerId" class="absolute inset-0 h-full w-full"></div>
        <div id="@(ContainerId)-legend" class="ohlc-legend"></div>

        @if (!_chartInitialized)
        {
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-[#15171c]/60">
                <i class="ph ph-chart-line mb-2 text-2xl text-slate-600"></i>
                <p class="font-mono text-xs text-slate-400">Insufficient chart data for this period</p>
                <p class="mt-1 font-mono text-[10px] text-slate-600">Collecting price ticks…</p>
            </div>
        }
    </div>
</div>
