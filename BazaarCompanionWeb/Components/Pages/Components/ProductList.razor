@using BazaarCompanionWeb.Dtos
@using BazaarCompanionWeb.Utilities
@using Microsoft.AspNetCore.Components.QuickGrid
@rendermode InteractiveServer

<PageTitle>@_pageTitle</PageTitle>

<div class="flex flex-1 flex-col min-h-0">
<!-- Watchlist tabs -->
<div class="flex items-center justify-between border-b border-[#2a2f38] bg-[#15171c]">
    <div class="flex items-center overflow-x-auto no-scrollbar">
        @foreach (var (key, label) in Tabs)
        {
            <button class="wtab @(_activeTab == key ? "active" : "")" @onclick="() => SetTabAsync(key)">@label</button>
        }
    </div>
    <div class="hidden shrink-0 px-3 font-mono text-[11px] text-slate-500 sm:block">
        @_totalItemCount.ToString("N0") products · @(_lastServerRefresh.Humanize() ?? "—")
    </div>
</div>

@if (_activeTab == "indices")
{
    <div class="flex-1 min-h-0 overflow-auto">
        <IndexList />
    </div>
}
else
{
<!-- Toolbar -->
<div class="flex flex-wrap items-center gap-2 border-b border-[#2a2f38] bg-[#1a1d23] px-3 py-2">
    <div class="relative group">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5">
            <i class="ph ph-magnifying-glass text-sm text-slate-500 group-focus-within:text-[#e64653]"></i>
        </div>
        <input type="text" value="@_searchString" @oninput="@OnSearchInput"
               placeholder="Filter or 'under 1000', 'high volume', 'fire sale'…"
               class="h-7 w-[300px] rounded border border-[#2a2f38] bg-[#101216] pl-8 pr-3 text-xs text-slate-200 placeholder-slate-500 focus:border-[#e64653]/60 focus:outline-none"/>
        @if (_searchHistory.Any())
        {
            <div class="absolute left-0 right-0 top-full z-50 mt-1 max-h-48 overflow-auto rounded border border-[#2a2f38] bg-[#1a1d23] shadow-xl">
                @foreach (var historyItem in _searchHistory.Take(5))
                {
                    <button @onclick="@(() => { _searchString = historyItem; OnSearchInput(new ChangeEventArgs { Value = historyItem }); })"
                            class="block w-full px-3 py-1.5 text-left text-xs text-slate-300 hover:bg-white/5 hover:text-white">
                        @historyItem
                    </button>
                }
            </div>
        }
    </div>

    <button @onclick="@(() => { _showAdvancedFilters = !_showAdvancedFilters; })"
            class="flex h-7 items-center gap-2 rounded border border-[#2a2f38] bg-[#101216] px-2.5 text-xs text-slate-300 hover:text-white">
        <i class="ph ph-funnel text-slate-400"></i> Filters
        @if (GetActiveFilterCount() > 0)
        {
            <span class="flex h-4 min-w-4 items-center justify-center rounded-full bg-[#e64653] px-1 text-[10px] font-bold text-white">@GetActiveFilterCount()</span>
        }
    </button>

    <label class="flex h-7 cursor-pointer items-center gap-2 rounded border border-[#2a2f38] bg-[#101216] px-2.5 text-xs text-slate-300 hover:text-white">
        <input type="checkbox" checked="@_useFuzzySearch"
               @onchange="@((ChangeEventArgs e) => { _useFuzzySearch = e.Value is true; _grid?.RefreshDataAsync(); })" class="peer sr-only"/>
        <span class="relative h-4 w-7 rounded-full bg-[#33373f] after:absolute after:left-[2px] after:top-[2px] after:h-3 after:w-3 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-[#e64653] peer-checked:after:translate-x-3"></span>
        Fuzzy
    </label>
</div>

@if (_showAdvancedFilters)
{
    <div class="grid grid-cols-1 gap-3 border-b border-[#2a2f38] bg-[#15171c] p-3 lg:grid-cols-4">
        <div class="lg:col-span-3">
            <AdvancedFilters Filters="@_advancedFilters" FiltersChanged="@OnAdvancedFiltersChanged"/>
        </div>
        <div class="lg:col-span-1">
            <FilterPresetManager CurrentFilters="@_advancedFilters" PresetLoaded="@OnPresetLoaded"/>
        </div>
    </div>
}

<!-- Quote grid -->
<div class="flex-1 min-h-0 overflow-auto">
    @if (_itemsProvider != null)
    {
        <QuickGrid @ref="_grid" ItemsProvider="@_itemsProvider" Pagination="@_pagination" Theme="custom"
                   Class="w-full text-left">
            <TemplateColumn Title="Product" Sortable="false">
                <div class="flex items-center gap-2 py-0.5 cursor-pointer group" @onclick="@(() => RowClickEvent(context))">
                    <span class="inline-block h-4 w-[3px] flex-none rounded-sm" style="background: @context.ItemTier.ProductTierColor()"></span>
                    <MinecraftHead SkinUrl="@context.SkinUrl" Tier="@context.ItemTier" Size="20" Border="1" Class="rounded-[3px]" />
                    @if (context.IsManipulated)
                    {
                        <i class="ph-fill ph-fire flex-none text-[#d99a00]"
                           title="@($"Fire sale — deviated {context.PriceDeviationPercent:F1}% from average")"></i>
                    }
                    <span class="truncate font-medium text-slate-200 group-hover:text-white">@context.ItemFriendlyName</span>
                </div>
            </TemplateColumn>

            <PropertyColumn TGridItem="ProductDataInfo" TProp="double" Property="@(p => p.BidUnitPrice)" Sortable="true"
                            Title="Bid" Format="N1" Class="text-[#16c784]"/>
            <PropertyColumn TGridItem="ProductDataInfo" TProp="double" Property="@(p => p.OrderMetaSpread)" Sortable="true"
                            Title="Spread" Format="N1" Class="text-slate-400"/>
            <PropertyColumn TGridItem="ProductDataInfo" TProp="double" Property="@(p => p.AskUnitPrice)" Sortable="true"
                            Title="Ask" Format="N1" Class="text-[#f6465d]"/>

            <TemplateColumn Title="Dev %" Sortable="false">
                @{
                    var dev = context.PriceDeviationPercent;
                    var devUp = dev >= 0;
                }
                @if (Math.Abs(dev) < 0.05)
                {
                    <span class="text-slate-600">—</span>
                }
                else
                {
                    <span class="inline-flex items-center justify-end gap-1.5" style="color: @(devUp ? "#16c784" : "#f6465d")">
                        <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: @(devUp ? "#16c784" : "#f6465d")"></span>
                        @(devUp ? "▲" : "▼") @Math.Abs(dev).ToString("F1")%
                    </span>
                }
            </TemplateColumn>

            <TemplateColumn Title="Profit x"
                            SortBy="@(GridSort<ProductDataInfo>.ByAscending(p => p.OrderMetaPotentialProfitMultiplier))">
                <span style="@($"color: {context.OrderMetaPotentialProfitMultiplier.MultiplierColor()}")">
                    @context.OrderMetaPotentialProfitMultiplier.ToString("N2")x
                </span>
            </TemplateColumn>

            <TemplateColumn Title="Rating" SortBy="@(GridSort<ProductDataInfo>.ByAscending(p => p.OrderMetaFlipOpportunityScore))">
                <span class="inline-block min-w-[30px] rounded-sm border px-1.5 py-px text-center text-[11px]"
                      style="color: @context.OrderMetaFlipOpportunityScore.RatingColor(); border-color: @(context.OrderMetaFlipOpportunityScore.RatingColor())55">
                    @context.OrderMetaFlipOpportunityScore.ToString("N1")
                </span>
            </TemplateColumn>

            <TemplateColumn Title="Est. Profit" SortBy="@(GridSort<ProductDataInfo>.ByAscending(p => p.EstimatedTotalProfit))">
                @if (context.EstimatedTotalProfit is > 0)
                {
                    <span class="text-[#d99a00]" title="@context.EstimatedTotalProfit?.ToString("N2")">@context.EstimatedTotalProfit?.ToCompactString()</span>
                }
                else
                {
                    <span class="text-slate-600">—</span>
                }
            </TemplateColumn>

            <PropertyColumn TGridItem="ProductDataInfo" TProp="double" Property="@(p => p.OrderMetaTotalWeekVolume)" Sortable="true"
                            Title="7d Vol." Format="N0" Class="text-slate-400"/>

            <TemplateColumn Title="Ord A/B" Class="hidden xl:table-cell">
                <span class="text-[#f6465d]">@context.AskCurrentOrders.ToMetric(decimals: 1)</span>
                <span class="text-slate-600"> / </span>
                <span class="text-[#16c784]">@context.BidCurrentOrders.ToMetric(decimals: 1)</span>
            </TemplateColumn>
        </QuickGrid>
    }
</div>

<!-- Pager -->
<div class="flex items-center justify-between border-t border-[#2a2f38] bg-[#1b1e24] px-3 py-1.5 font-mono text-[11px] text-slate-500">
    <div>
        Showing <span class="text-slate-300">@(Math.Min(_pagination.ItemsPerPage, _totalItemCount))</span>
        of <span class="text-slate-300">@_totalItemCount.ToString("N0")</span>
    </div>
    <div class="flex items-center gap-2.5">
        @{
            var lastPageIndex = _totalItemCount > 0 ? (int)Math.Ceiling((double)_totalItemCount / _pagination.ItemsPerPage) - 1 : 0;
        }
        <div class="flex items-center overflow-hidden rounded border border-[#2a2f38]">
            <button @onclick="@(() => ChangePage(Math.Max(0, _currentPageIndex - 1)))" disabled="@(_currentPageIndex == 0)"
                    aria-label="Previous page"
                    class="border-r border-[#2a2f38] px-2.5 py-1 text-slate-300 hover:bg-white/5 hover:text-white disabled:opacity-30">
                <i class="ph ph-caret-left" aria-hidden="true"></i>
            </button>
            <span class="px-2.5 text-slate-400">@(_currentPageIndex + 1)<span class="text-slate-600">/</span>@(lastPageIndex + 1)</span>
            <button @onclick="@(() => ChangePage(Math.Min(lastPageIndex, _currentPageIndex + 1)))" disabled="@(_currentPageIndex >= lastPageIndex)"
                    aria-label="Next page"
                    class="border-l border-[#2a2f38] px-2.5 py-1 text-slate-300 hover:bg-white/5 hover:text-white disabled:opacity-30">
                <i class="ph ph-caret-right" aria-hidden="true"></i>
            </button>
        </div>
        <select value="@_pagination.ItemsPerPage"
                @onchange="@((ChangeEventArgs e) => ChangeItemsPerPage(int.Parse(e.Value?.ToString() ?? "25")))"
                class="rounded border border-[#2a2f38] bg-[#101216] px-1.5 py-1 text-slate-300 focus:border-[#e64653]/60 focus:outline-none">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>
}
</div>
