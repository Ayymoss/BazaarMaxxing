@using BazaarCompanionWeb.Entities
@rendermode InteractiveServer

<div class="relative inline-block text-left" tabindex="0">
    <button type="button"
            class="flex items-center gap-2 rounded border border-[#2a2f38] bg-[#101216] pl-2.5 pr-7 py-1 text-[11px] font-mono font-medium text-slate-300 transition-colors hover:text-white focus:border-[#e64653]/60 focus:outline-none"
            @onclick="Toggle"
            @onclick:stopPropagation>
        @GetShortName(SelectedInterval)
        <i class="ph ph-caret-down absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-slate-500 transition-transform @(_isOpen ? "rotate-180" : "")"></i>
    </button>

    @if (_isOpen)
    {
        <div class="fixed inset-0 z-40" @onclick="Close"></div>

        <div class="absolute left-0 z-50 mt-1 w-24 origin-top-left rounded border border-[#2a2f38] bg-[#1a1d23] p-1 shadow-xl">
            <div class="flex flex-col gap-0.5">
                @foreach (CandleInterval interval in Enum.GetValues<CandleInterval>().OrderBy(x => (int)x))
                {
                    <button type="button"
                            class="flex items-center justify-between rounded px-2 py-1.5 text-left text-[11px] font-mono font-medium transition-colors @(SelectedInterval == interval ? "bg-[#e64653]/15 text-[#f25c68]" : "text-slate-400 hover:bg-white/5 hover:text-slate-200")"
                            @onclick="() => SelectInterval(interval)"
                            @onclick:stopPropagation>
                        @GetShortName(interval)
                        @if (SelectedInterval == interval)
                        {
                            <i class="ph ph-check text-[8px]"></i>
                        }
                    </button>
                }
            </div>
        </div>
    }
</div>
