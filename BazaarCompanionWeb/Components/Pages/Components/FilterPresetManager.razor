@using BazaarCompanionWeb.Models.Pagination
@using BazaarCompanionWeb.Utilities
@using Microsoft.AspNetCore.Components
@using System.Text.Json
@inject BrowserStorage BrowserStorage

<div class="flex flex-col gap-2">
    <div class="flex items-center justify-between">
        <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">Filter Presets</label>
        <button @onclick="ShowSaveDialog"
                class="rounded px-2 py-1 text-[10px] text-[#e64653] transition-colors hover:bg-white/5 hover:text-[#f25c68]">
            <i class="ph ph-floppy-disk mr-1"></i> Save
        </button>
    </div>

    <select @onchange="@(async (ChangeEventArgs e) => await LoadPreset(e))"
            class="rounded border border-[#2a2f38] bg-[#101216] px-2 py-1.5 text-xs text-slate-300 focus:border-[#e64653]/60 focus:outline-none">
        <option value="">Select preset...</option>
        @foreach (var preset in _presets)
        {
            <option value="@preset.Name">@preset.Name</option>
        }
    </select>

    @if (_presets.Any())
    {
        <div class="mt-1 flex flex-wrap gap-1.5">
            @foreach (var preset in _presets)
            {
                <div class="flex items-center gap-1.5 rounded border border-[#2a2f38] bg-[#101216] px-2 py-0.5">
                    <button @onclick="@(async () => await LoadPresetByName(preset.Name))"
                            class="text-[10px] text-slate-300 transition-colors hover:text-white">
                        @preset.Name
                    </button>
                    <button @onclick="@(async () => await DeletePreset(preset.Name))"
                            aria-label="@($"Delete preset {preset.Name}")"
                            title="@($"Delete preset {preset.Name}")"
                            class="text-slate-500 transition-colors hover:text-[#f6465d]">
                        <i class="ph ph-x text-[10px]" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </div>
    }

    @if (_showSaveDialog)
    {
        <div class="mt-2 rounded border border-[#2a2f38] bg-[#101216] p-2">
            <input type="text"
                   @bind="_newPresetName"
                   @bind:event="oninput"
                   placeholder="Preset name..."
                   class="mb-2 w-full rounded border border-[#2a2f38] bg-[#15171c] px-2 py-1 text-xs text-slate-300 focus:border-[#e64653]/60 focus:outline-none"/>
            <div class="flex gap-2">
                <button @onclick="@(async () => await SavePreset())"
                        class="flex-1 rounded bg-[#e64653] px-2 py-1 text-xs font-medium text-white transition-colors hover:bg-[#f25c68]">
                    Save
                </button>
                <button @onclick="CancelSave"
                        class="flex-1 rounded border border-[#2a2f38] bg-[#15171c] px-2 py-1 text-xs text-slate-300 transition-colors hover:text-white">
                    Cancel
                </button>
            </div>
        </div>
    }
</div>
