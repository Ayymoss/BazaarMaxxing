@namespace BazaarCompanionWeb.Components.Pages.Components
@using BazaarCompanionWeb.Configurations
@using BazaarCompanionWeb.Services
@using Microsoft.Extensions.Options
@inject MarketInsightsService InsightsService
@inject IJSRuntime JSRuntime
@inject IOptions<UIConfig> UIConfig
@implements IDisposable

@{
    var movers = (_insights?.Gainers ?? []).Concat(_insights?.Losers ?? []).Take(16).ToList();
}
<div class="ticker">
    <div class="lbl"><i class="ph-fill ph-fire" style="color: var(--term-gold)"></i> Movers</div>
    <div class="items">
        @if (movers.Count == 0)
        {
            <span class="tk"><span class="sym">Awaiting market data…</span></span>
        }
        else
        {
            @foreach (var m in movers)
            {
                <span class="tk" @onclick="() => OnProductClick(m.ProductKey)">
                    <span class="dot" style="background: @(m.IsGainer ? "var(--term-up)" : "var(--term-down)")"></span>
                    <span class="sym">@m.ProductName</span>
                    <span style="color: @(m.IsGainer ? "var(--term-up)" : "var(--term-down)")">@(m.IsGainer ? "+" : "")@m.PriceChangePercent24h.ToString("P2")</span>
                </span>
            }
        }
    </div>
</div>
