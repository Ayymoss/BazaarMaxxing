@using BazaarCompanionWeb.Dtos
@inject NavigationManager Nav

@if (!TrendingProducts.Any())
{
    <div class="flex flex-col items-center justify-center gap-2 py-12 text-slate-500">
        @if (Loading)
        {
            <i class="ph ph-circle-notch animate-spin text-2xl"></i>
            <p class="font-mono text-xs">Scanning momentum…</p>
        }
        else
        {
            <i class="ph ph-chart-line text-2xl"></i>
            <p class="text-xs">No trend data available</p>
        }
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table theme class="w-full text-left">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Trend</th>
                    <th>6h</th>
                    <th>24h</th>
                    <th>7d</th>
                    <th>Strength</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in TrendingProducts)
                {
                    var col = t.TrendDirection switch
                    {
                        "Bullish" => "#16c784",
                        "Bearish" => "#f6465d",
                        "Volatile" => "#d99a00",
                        _ => "#9aa0aa"
                    };
                    <tr class="cursor-pointer" @onclick="() => Go(t.ProductKey)">
                        <td><span class="font-medium text-slate-200">@t.ProductName</span></td>
                        <td><span class="inline-flex items-center gap-1.5" style="color:@col"><span class="inline-block h-1.5 w-1.5 rounded-full" style="background:@col"></span>@t.TrendDirection</span></td>
                        <td style="color:@(t.PriceChange6h >= 0 ? "#16c784" : "#f6465d")">@(t.PriceChange6h >= 0 ? "+" : "")@t.PriceChange6h.ToString("F2")%</td>
                        <td style="color:@(t.PriceChange24h >= 0 ? "#16c784" : "#f6465d")">@(t.PriceChange24h >= 0 ? "+" : "")@t.PriceChange24h.ToString("F2")%</td>
                        <td style="color:@(t.PriceChange7d >= 0 ? "#16c784" : "#f6465d")">@(t.PriceChange7d >= 0 ? "+" : "")@t.PriceChange7d.ToString("F2")%</td>
                        <td class="text-slate-400">@t.MomentumStrength.ToString("F1")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public List<ProductTrend> TrendingProducts { get; set; } = [];
    [Parameter] public bool Loading { get; set; }

    private void Go(string key) => Nav.NavigateTo($"/product/{key}");
}
