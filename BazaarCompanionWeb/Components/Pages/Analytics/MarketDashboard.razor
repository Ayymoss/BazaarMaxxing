@page "/analytics"
@using BazaarCompanionWeb.Components.Pages.Analytics
@using BazaarCompanionWeb.Components.Pages.Components
@using BazaarCompanionWeb.Dtos
@using BazaarCompanionWeb.Services
@rendermode InteractiveServer

<PageTitle>Market Analytics · Bazaar Maxxing</PageTitle>

<div class="mx-auto flex w-full max-w-[1920px] flex-col gap-3">
    <PageHeader Title="Market Analytics" Icon="ph-chart-bar">
        <Status>
            <div class="flex items-center gap-1.5 font-mono text-[11px] text-slate-500">
                <span class="h-1.5 w-1.5 rounded-full @(_lastUpdate is null ? "bg-slate-600" : "bg-emerald-500")"></span>
                @(_lastUpdate is null ? "Loading…" : $"Updated {_lastUpdate.Value.Humanize()}")
            </div>
        </Status>
        <Actions>
            <label class="flex cursor-pointer select-none items-center gap-1.5 text-xs text-slate-400">
                <input type="checkbox" @bind="_autoRefresh" @bind:after="OnAutoRefreshToggled"
                       class="h-3.5 w-3.5 rounded border-[#2a2f38] bg-[#101216] text-[#e64653] focus:ring-1 focus:ring-[#e64653]"/>
                Auto-refresh
            </label>
            <button @onclick="LoadDataAsync" disabled="@Loading" aria-label="Refresh analytics"
                    class="flex items-center gap-1.5 rounded border border-[#2a2f38] bg-[#101216] px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:text-white disabled:opacity-50">
                <i class="ph @(Loading ? "ph-circle-notch animate-spin" : "ph-arrow-clockwise")"></i> Refresh
            </button>
        </Actions>
    </PageHeader>

    <!-- Market metrics -->
    @if (_metrics is not null)
    {
        <MarketMetricsPanel Metrics="@_metrics" />
    }
    else if (_metricsLoading)
    {
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-6">
            @for (var i = 0; i < 6; i++)
            {
                <div class="h-[68px] animate-pulse rounded-md border border-[#2a2f38] bg-[#1a1d23]"></div>
            }
        </div>
    }

    <!-- Trend analysis -->
    <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23]">
        <div class="phdr">
            <span><i class="ph ph-trend-up mr-1.5 text-slate-500"></i>Momentum Leaders</span>
            @if (_trendsLoading)
            {
                <i class="ph ph-circle-notch animate-spin text-slate-500"></i>
            }
            else
            {
                <span class="font-mono text-[11px] normal-case text-slate-500">@_trendingProducts.Count shown</span>
            }
        </div>
        <TrendAnalysis TrendingProducts="@_trendingProducts" Loading="@_trendsLoading" />
    </div>
</div>
