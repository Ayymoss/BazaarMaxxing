@using BazaarCompanionWeb.Dtos
@using System.Globalization

<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-6">
    <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23] px-3 py-2.5">
        <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Market Cap</p>
        <p class="font-mono text-lg font-semibold tracking-tight text-slate-200">@Metrics.TotalMarketCapitalization.ToString("N0", CultureInfo.InvariantCulture)</p>
        <p class="mt-0.5 font-mono text-[10px] text-slate-600">Total bid value</p>
    </div>

    <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23] px-3 py-2.5">
        <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Avg Spread</p>
        <p class="font-mono text-lg font-semibold tracking-tight text-slate-200">@Metrics.AverageSpread.ToString("P2", CultureInfo.InvariantCulture)</p>
        <p class="mt-0.5 font-mono text-[10px] text-slate-600">Median, liquid items</p>
    </div>

    <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23] px-3 py-2.5">
        <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Manipulation</p>
        <p class="font-mono text-lg font-semibold tracking-tight" style="color: @(Metrics.MarketManipulationIndex > 10 ? "#f6465d" : Metrics.MarketManipulationIndex > 5 ? "#d99a00" : "#16c784")">
            @Metrics.MarketManipulationIndex.ToString("F1", CultureInfo.InvariantCulture)%
        </p>
        <p class="mt-0.5 font-mono text-[10px] text-slate-600">Flagged products</p>
    </div>

    <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23] px-3 py-2.5">
        <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Active Products</p>
        <p class="font-mono text-lg font-semibold tracking-tight text-slate-200">@Metrics.ActiveProductsCount.ToString("N0")</p>
        <p class="mt-0.5 font-mono text-[10px] text-slate-600">With orders</p>
    </div>

    <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23] px-3 py-2.5">
        <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Health Score</p>
        <p class="font-mono text-lg font-semibold tracking-tight" style="color: @(Metrics.MarketHealthScore >= 70 ? "#16c784" : Metrics.MarketHealthScore >= 50 ? "#d99a00" : "#f6465d")">
            @Metrics.MarketHealthScore.ToString("F0", CultureInfo.InvariantCulture)
        </p>
        <p class="mt-0.5 font-mono text-[10px] text-slate-600">Spread + liquidity</p>
    </div>

    <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23] px-3 py-2.5">
        <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-500">24h Volume</p>
        <p class="font-mono text-lg font-semibold tracking-tight text-slate-200">@Metrics.VolumeTrends.Volume24h.ToString("N0", CultureInfo.InvariantCulture)</p>
        <p class="mt-0.5 font-mono text-[10px] text-slate-600">Est. from weekly</p>
    </div>
</div>

@code {
    [Parameter] public required MarketMetrics Metrics { get; set; }
}
