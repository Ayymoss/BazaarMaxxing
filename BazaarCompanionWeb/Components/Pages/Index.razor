@page "/index/{IndexSlug}"
@using BazaarCompanionWeb.Components.Pages.Components
@using BazaarCompanionWeb.Components.Pages.Dialogs.Components
@using BazaarCompanionWeb.Utilities
@rendermode InteractiveServer

<PageTitle>@(_index?.Name ?? "Loading...") | Bazaar Maxxing</PageTitle>
<div class="flex flex-col gap-3 w-full max-w-[1920px] mx-auto">
    <PageHeader BackHref="/" Title="@(_index?.Name ?? "Index")" Icon="ph-chart-pie-slice">
        <Status>
            <div class="flex items-center gap-3 font-mono text-[11px] text-slate-500">
                <span class="flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Live Aggregate</span>
                <span>@_underlyingProducts.Count components · equal-weighted</span>
            </div>
        </Status>
        <Actions>
            <span class="rounded border border-[#2a2f38] bg-[#101216] px-2.5 py-1 font-mono text-[11px] text-slate-300">@IndexSlug</span>
        </Actions>
    </PageHeader>

    @if (_loading)
    {
        <div class="flex flex-col items-center justify-center py-32">
            <div class="mb-4 text-[#e64653]">
                <svg class="h-8 w-8 animate-spin" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
            <p class="text-sm font-medium text-slate-500 animate-pulse uppercase tracking-widest">Hydrating Market Data</p>
        </div>
    }
    else if (_index is null)
    {
        <div class="flex flex-col items-center justify-center py-32 rounded-md border border-[#2a2f38] bg-[#1a1d23]">
            <i class="ph ph-warning-circle text-5xl text-[#f6465d] mb-4"></i>
            <h2 class="text-xl font-semibold text-white">Index Expansion Failed</h2>
            <p class="mt-2 text-sm text-slate-500 text-center max-w-xs">
                The index identifier "@IndexSlug" could not be resolved.
            </p>
            <a href="/" class="mt-6 px-6 py-2.5 rounded-md bg-[#e64653] hover:bg-[#f25c68] text-white text-sm font-semibold transition-colors">
                Return to Markets
            </a>
        </div>
    }
    else
    {
        <!-- Chart Section -->
        <div class="w-full rounded-md overflow-hidden border border-[#2a2f38]">
            <IndexPriceGraph IndexSlug="@IndexSlug" IndexName="@_index.Name" Interval="@_selectedInterval" IntervalChanged="@OnIntervalChangedAsync"/>
        </div>

        <!-- Underlying Products Dashboard -->
        <div class="rounded-md border border-[#2a2f38] bg-[#1a1d23] p-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
                <div>
                    <h2 class="text-xl font-semibold text-white tracking-tight">Index Constituents</h2>
                    <p class="text-sm text-slate-500 mt-1">Direct access to the underlying market sectors.</p>
                </div>
                <div class="flex items-center gap-2 px-4 py-2 rounded-md bg-[#101216] border border-[#2a2f38] text-slate-300 font-semibold text-xs uppercase tracking-widest">
                    <i class="ph ph-arrows-merge"></i>
                    Intersection Aggregated
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                @foreach (var product in _underlyingProducts)
                {
                    <a href="/product/@product.ProductKey"
                       class="group rounded-md border border-[#2a2f38] bg-[#1a1d23] p-5 transition-colors hover:border-[#e64653]/40 hover:bg-white/[0.02]">
                        <div>
                            <div class="flex items-center gap-4">
                                <div>
                                    <MinecraftHead SkinUrl="@product.SkinUrl" Size="40" Class="rounded-md border border-[#2a2f38]" Tier="@product.ProductTier" />
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-sm font-semibold text-slate-200 truncate group-hover:text-white transition-colors">
                                        @product.FriendlyName
                                    </h4>
                                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-0.5">
                                        <span class="text-[10px] font-semibold text-slate-500 uppercase">Mid</span>
                                        <span class="text-[10px] font-mono font-semibold text-slate-200">@product.CurrentPrice.ToString("N1")</span>
                                        <span class="text-slate-500">·</span>
                                        <span class="text-[10px] font-semibold text-slate-500 uppercase">7d Vol</span>
                                        <span class="text-[10px] font-mono font-semibold text-slate-200">@product.WeekVolume.ToString("N0")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 pt-4 border-t border-[#2a2f38] flex items-center justify-between">
                                <span class="px-2 py-0.5 rounded bg-[#101216] text-[9px] font-semibold text-slate-500 uppercase tracking-tighter">1/N Weight</span>
                                <i class="ph ph-arrow-right text-slate-500 group-hover:text-[#e64653] transition-colors"></i>
                            </div>
                        </div>
                    </a>
                }

                @foreach (var productKey in _missingProductKeys)
                {
                    <div class="rounded-md border border-[#2a2f38] bg-[#101216] p-5 grayscale opacity-40">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-md bg-[#101216] border border-[#2a2f38] flex items-center justify-center">
                                <i class="ph ph-cube text-slate-500"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-medium text-slate-500">
                                    @productKey.Replace("_", " ").ToLower().Humanize()
                                </h4>
                                <span class="text-[10px] font-semibold text-slate-500 uppercase">Sync Pending</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="mt-8 rounded-md border border-[#2a2f38] bg-[#1a1d23] p-6 flex flex-col md:flex-row items-center gap-6">
            <div class="p-3 rounded-md bg-[#101216] text-[#e64653]">
                <i class="ph ph-info text-2xl"></i>
            </div>
            <div>
                <h4 class="text-white font-semibold text-sm">Normalization Methodology</h4>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                    This index represents a <span class="text-slate-200 font-semibold">normalized equal-weighted average</span> of its constituents.
                    Calculated by resetting each product to 100 on the first joint data point, ensuring low-price and high-price items move the scale proportionally.
                </p>
            </div>
        </div>
    }
</div>
